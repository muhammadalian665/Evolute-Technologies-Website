/* =====================================================
   EVOLUTE TECHNOLOGIES
   WEB & MOBILE APPLICATIONS
   PREMIUM LIGHT UI — EVOLUTE BRAND COLORS
===================================================== */

:root {
    --evo-blue: #0950CD;
    --evo-cyan: #3CD2F9;
    --evo-dark: #0A1428;
    --evo-text: #172033;
    --evo-muted: #667085;
    --evo-light: #F7F9FC;
    --evo-border: #C8D0DC;
    --evo-border-dark: #AEB8C6;
    --evo-white: #FFFFFF;

    /* Button Colors */
    --evo-blue-hover: #073FA5;
    --evo-blue-active: #06378F;

    /* Button Shadows */
    --evo-button-shadow: rgba(9, 80, 205, 0.18);
    --evo-button-shadow-hover: rgba(9, 80, 205, 0.28);
}


/* =====================================================
   GLOBAL
===================================================== */

.web-mobile-page {
    width: 100%;
    overflow: hidden;

    background: var(--evo-white);
    color: var(--evo-text);
}

.web-mobile-page *,
.web-mobile-page *::before,
.web-mobile-page *::after {
    box-sizing: border-box;
}

.web-mobile-page a {
    text-decoration: none;
    color: inherit;
}

.section-kicker {
    display: inline-flex;
    align-items: center;
    gap: 9px;

    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.18em;

    color: var(--evo-blue);
}

.section-kicker::before {
    content: "";

    width: 30px;
    height: 3px;

    background:
        linear-gradient(
            90deg,
            var(--evo-blue),
            var(--evo-cyan)
        );
}


/* =====================================================
   BUTTONS
   EVOLUTE STANDARD BUTTON SYSTEM
===================================================== */

/* -----------------------------------------------------
   PRIMARY BUTTON
----------------------------------------------------- */

.primary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;

    min-height: 54px;
    padding: 0 25px;

    border: 2px solid var(--evo-blue);
    border-radius: 12px;

    background: var(--evo-blue);
    color: var(--evo-white);

    font-size: 14px;
    font-weight: 700;

    cursor: pointer;

    box-shadow:
        0 12px 30px var(--evo-button-shadow);

    transition:
        background-color 0.3s ease,
        border-color 0.3s ease,
        color 0.3s ease,
        transform 0.3s ease,
        box-shadow 0.3s ease;
}

.primary-button:hover {
    transform: translateY(-3px);

    background: var(--evo-blue-hover);
    border-color: var(--evo-blue-hover);
    color: var(--evo-white);

    box-shadow:
        0 18px 38px var(--evo-button-shadow-hover);
}

.primary-button:active {
    transform: translateY(-1px);

    background: var(--evo-blue-active);
    border-color: var(--evo-blue-active);
}

.primary-button:focus-visible {
    outline: 3px solid rgba(60, 210, 249, 0.45);
    outline-offset: 4px;
}


/* -----------------------------------------------------
   TEXT / SECONDARY BUTTON
----------------------------------------------------- */

.text-button {
    display: inline-flex;
    align-items: center;
    gap: 9px;

    padding: 6px 0;

    border: 0;
    background: transparent;

    font-size: 14px;
    font-weight: 700;

    color: var(--evo-text);

    cursor: pointer;

    transition:
        color 0.3s ease,
        gap 0.3s ease;
}

.text-button:hover {
    color: var(--evo-blue);
    gap: 13px;
}

.text-button:focus-visible {
    outline: 2px solid var(--evo-cyan);
    outline-offset: 4px;
}


/* -----------------------------------------------------
   GENERIC OUTLINE BUTTON
   Use this anywhere you need secondary CTA
----------------------------------------------------- */

.secondary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;

    min-height: 54px;
    padding: 0 25px;

    border: 2px solid var(--evo-blue);
    border-radius: 12px;

    background: var(--evo-white);
    color: var(--evo-blue);

    font-size: 14px;
    font-weight: 700;

    cursor: pointer;

    transition:
        background-color 0.3s ease,
        border-color 0.3s ease,
        color 0.3s ease,
        transform 0.3s ease,
        box-shadow 0.3s ease;
}

.secondary-button:hover {
    transform: translateY(-3px);

    background: var(--evo-blue);
    border-color: var(--evo-blue);
    color: var(--evo-white);

    box-shadow:
        0 15px 35px rgba(9, 80, 205, 0.20);
}

.secondary-button:active {
    transform: translateY(-1px);

    background: var(--evo-blue-hover);
    border-color: var(--evo-blue-hover);
}


/* -----------------------------------------------------
   CTA TALK TO OUR TEAM
----------------------------------------------------- */

.cta-talk-button {
    display: inline-flex;
    align-items: center;
    gap: 9px;

    min-height: 54px;
    padding: 0 24px;

    border: 2px solid var(--evo-blue);
    border-radius: 12px;

    background: var(--evo-white);
    color: var(--evo-blue);

    font-size: 14px;
    font-weight: 700;

    cursor: pointer;

    transition:
        background-color 0.3s ease,
        border-color 0.3s ease,
        color 0.3s ease,
        gap 0.3s ease,
        transform 0.3s ease,
        box-shadow 0.3s ease;
}

.cta-talk-button:hover {
    gap: 13px;

    transform: translateY(-3px);

    background: var(--evo-blue);
    border-color: var(--evo-blue);
    color: var(--evo-white);

    box-shadow:
        0 15px 35px rgba(9, 80, 205, 0.22);
}

.cta-talk-button:active {
    transform: translateY(-1px);

    background: var(--evo-blue-hover);
    border-color: var(--evo-blue-hover);
}

.cta-talk-button:focus-visible {
    outline: 3px solid rgba(60, 210, 249, 0.45);
    outline-offset: 4px;
}


/* =====================================================
   HERO
===================================================== */

.web-mobile-hero {
    position: relative;

    min-height: 900px;

    display: flex;
    align-items: center;

    overflow: hidden;

    background:
        radial-gradient(
            circle at 80% 40%,
            rgba(60, 210, 249, 0.12),
            transparent 28%
        ),
        radial-gradient(
            circle at 15% 25%,
            rgba(9, 80, 205, 0.06),
            transparent 30%
        ),
        var(--evo-white);
}

.web-mobile-hero-container {
    position: relative;
    z-index: 5;

    width: min(1380px, 90%);

    margin: 0 auto;

    display: grid;
    grid-template-columns: 0.9fr 1.1fr;

    align-items: center;

    gap: 30px;
}


/* =====================================================
   HERO BACKGROUND
===================================================== */

.hero-background-glow {
    position: absolute;

    width: 480px;
    height: 480px;

    border-radius: 50%;

    filter: blur(80px);

    pointer-events: none;
}

.hero-glow-left {
    top: 5%;
    left: -280px;

    background: rgba(60, 210, 249, 0.12);
}

.hero-glow-right {
    right: -250px;
    bottom: 5%;

    background: rgba(9, 80, 205, 0.08);
}


/* =====================================================
   HERO CONTENT
===================================================== */

.web-mobile-hero-content {
    position: relative;
    z-index: 10;

    max-width: 650px;
}

.eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;

    margin-bottom: 26px;

    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.2em;

    color: var(--evo-blue);
}

.eyebrow-dot {
    width: 8px;
    height: 8px;

    border-radius: 50%;

    background: var(--evo-cyan);

    box-shadow:
        0 0 0 6px rgba(60, 210, 249, 0.12);
}

.eyebrow-line {
    width: 45px;
    height: 2px;

    background: var(--evo-border-dark);
}

.web-mobile-hero-content h1 {
    margin: 0;

    font-size: clamp(48px, 5vw, 78px);
    line-height: 1.04;

    letter-spacing: -0.055em;

    font-weight: 800;

    color: var(--evo-dark);
}

.web-mobile-hero-content h1 span {
    position: relative;

    color: var(--evo-blue);
}

.web-mobile-hero-content h1 span::after {
    content: "";

    position: absolute;

    left: 3px;
    right: 3px;
    bottom: -7px;

    height: 6px;

    border-radius: 10px;

    background:
        linear-gradient(
            90deg,
            var(--evo-blue),
            var(--evo-cyan)
        );

    opacity: 0.85;
}

.hero-description {
    max-width: 590px;

    margin: 30px 0 0;

    font-size: 17px;
    line-height: 1.8;

    color: var(--evo-muted);
}

.hero-buttons {
    display: flex;
    align-items: center;
    gap: 30px;

    margin-top: 34px;
}

.hero-proof {
    display: flex;
    align-items: center;

    margin-top: 58px;
}

.proof-item {
    display: flex;
    flex-direction: column;

    gap: 4px;

    min-width: 125px;
}

.proof-item strong {
    font-size: 15px;

    color: var(--evo-blue);
}

.proof-item span {
    font-size: 11px;

    color: var(--evo-muted);
}

.proof-divider {
    width: 2px;
    height: 40px;

    margin: 0 18px;

    background: var(--evo-border-dark);
}


/* =====================================================
   HERO VISUAL
===================================================== */

.web-mobile-hero-visual-wrapper {
    min-width: 0;
}

.hero-visual {
    position: relative;

    width: 100%;
    min-height: 650px;

    display: flex;
    align-items: center;
    justify-content: center;

    perspective: 1400px;
}

.hero-visual-grid {
    position: absolute;

    width: 560px;
    height: 560px;

    border-radius: 50%;

    background:
        linear-gradient(
            rgba(10, 20, 40, 0.11) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(10, 20, 40, 0.11) 1px,
            transparent 1px
        );

    background-size: 28px 28px;

    mask-image: radial-gradient(
        circle,
        black 20%,
        transparent 72%
    );

    -webkit-mask-image: radial-gradient(
        circle,
        black 20%,
        transparent 72%
    );
}

.hero-orbit {
    position: absolute;

    border: 2px solid rgba(9, 80, 205, 0.22);

    border-radius: 50%;

    pointer-events: none;
}

.hero-orbit-one {
    width: 530px;
    height: 530px;
}

.hero-orbit-two {
    width: 400px;
    height: 400px;

    border-color: rgba(60, 210, 249, 0.32);
}


/* =====================================================
   MAIN 3D DEVICE
===================================================== */

.hero-main-device {
    position: relative;
    z-index: 5;

    width: min(600px, 76%);
    min-height: 390px;

    overflow: hidden;

    border-radius: 20px;

    background: var(--evo-white);

    border: 2px solid #B8C2D0;

    box-shadow:
        0 45px 90px rgba(17, 40, 80, 0.16),
        0 15px 35px rgba(9, 80, 205, 0.08);

    transform-style: preserve-3d;
}

.device-browser-bar {
    height: 46px;

    display: flex;
    align-items: center;

    padding: 0 17px;

    border-bottom: 2px solid #D1D8E2;

    background: #FBFCFE;
}

.browser-dots {
    display: flex;
    gap: 6px;
}

.browser-dots span {
    width: 8px;
    height: 8px;

    border-radius: 50%;

    background: #AEB7C4;
}

.browser-address {
    margin-left: 30px;

    padding: 5px 16px;

    border-radius: 7px;

    background: #E9EDF3;
    color: #7A8595;

    font-size: 9px;
}

.device-interface {
    display: flex;

    min-height: 344px;
}

.interface-sidebar {
    width: 62px;

    display: flex;
    flex-direction: column;
    align-items: center;

    gap: 14px;

    padding-top: 18px;

    border-right: 2px solid #D1D8E2;

    background: #FCFDFF;
}

.interface-sidebar > span {
    width: 34px;
    height: 34px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 9px;

    color: #8994A4;
}

.interface-sidebar .sidebar-active {
    color: var(--evo-blue);

    background: rgba(9, 80, 205, 0.10);

    border: 1px solid rgba(9, 80, 205, 0.18);
}

.interface-logo {
    width: 31px;
    height: 31px;

    display: flex;
    align-items: center;
    justify-content: center;

    margin-bottom: 10px;

    border-radius: 9px;

    background: var(--evo-blue);
    color: var(--evo-white);

    font-size: 13px;
    font-weight: 800;
}

.interface-main {
    flex: 1;

    padding: 25px;
}

.interface-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.interface-header small {
    font-size: 8px;
    letter-spacing: 0.13em;

    color: #7C8797;
}

.interface-header h4 {
    margin: 5px 0 0;

    font-size: 16px;

    color: var(--evo-dark);
}

.interface-user {
    width: 32px;
    height: 32px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background:
        linear-gradient(
            135deg,
            var(--evo-blue),
            var(--evo-cyan)
        );

    color: var(--evo-white);

    font-size: 9px;
    font-weight: 800;
}

.interface-stat-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);

    gap: 10px;

    margin-top: 22px;
}

.interface-stat-grid > div {
    padding: 13px;

    border: 2px solid #D3DAE4;

    border-radius: 10px;

    background: var(--evo-white);
}

.interface-stat-grid small {
    display: block;

    font-size: 7px;
    letter-spacing: 0.1em;

    color: #7C8797;
}

.interface-stat-grid strong {
    display: block;

    margin-top: 6px;

    font-size: 15px;

    color: var(--evo-dark);
}

.interface-stat-grid span {
    display: block;

    margin-top: 3px;

    font-size: 8px;
    font-weight: 700;

    color: #20A66A;
}

.interface-chart {
    position: relative;

    height: 170px;

    margin-top: 15px;

    padding: 16px;

    border: 2px solid #D3DAE4;

    border-radius: 12px;

    overflow: hidden;
}

.chart-heading {
    display: flex;
    justify-content: space-between;
}

.chart-heading span {
    font-size: 10px;
    font-weight: 700;

    color: var(--evo-dark);
}

.chart-heading small {
    font-size: 8px;

    color: #7C8797;
}

.chart-lines {
    position: absolute;

    top: 48px;
    left: 16px;
    right: 16px;
    bottom: 15px;

    display: flex;
    flex-direction: column;
    justify-content: space-between;
}

.chart-lines span {
    width: 100%;
    height: 2px;

    background: #D7DEE8;
}

.chart-svg {
    position: absolute;

    left: 16px;
    right: 16px;
    bottom: 13px;

    width: calc(100% - 32px);
    height: 100px;
}


/* =====================================================
   FLOATING HERO CARDS
===================================================== */

.hero-floating-card {
    position: absolute;
    z-index: 10;

    display: flex;
    align-items: center;
    gap: 10px;

    padding: 12px 15px;

    border: 2px solid #BFC9D6;

    border-radius: 12px;

    background: rgba(255, 255, 255, 0.94);

    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);

    box-shadow:
        0 18px 35px rgba(15, 35, 70, 0.12);
}

.hero-floating-card > svg {
    color: var(--evo-blue);
}

.hero-floating-card div {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.hero-floating-card strong {
    font-size: 9px;
    letter-spacing: 0.1em;

    color: var(--evo-dark);
}

.hero-floating-card span {
    font-size: 8px;

    color: var(--evo-muted);
}

.floating-web-card {
    top: 18%;
    left: 4%;
}

.floating-mobile-card {
    right: 2%;
    bottom: 19%;
}

.floating-api-card {
    left: 13%;
    bottom: 11%;
}

.hero-micro-label {
    position: absolute;

    display: flex;
    align-items: center;
    gap: 7px;

    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.13em;

    color: #7D8795;
}

.hero-micro-label span {
    width: 6px;
    height: 6px;

    border-radius: 50%;

    background: var(--evo-cyan);

    box-shadow:
        0 0 0 3px rgba(60, 210, 249, 0.12);
}

.label-top {
    right: 5%;
    top: 13%;
}

.label-bottom {
    right: 7%;
    bottom: 10%;

    color: var(--evo-blue);
}


/* =====================================================
   HERO SCROLL
===================================================== */

.hero-bottom-scroll {
    position: absolute;

    left: 50%;
    bottom: 28px;

    transform: translateX(-50%);

    display: flex;
    align-items: center;
    gap: 8px;

    color: #7C8795;

    font-size: 10px;
    letter-spacing: 0.08em;
}

.hero-bottom-scroll svg {
    color: var(--evo-blue);
}


/* =====================================================
   INTRO
===================================================== */

.application-intro {
    position: relative;

    padding: 130px 0;

    background: #F8FAFD;

    border-top: 2px solid var(--evo-border);
    border-bottom: 2px solid var(--evo-border);
}

.intro-container {
    width: min(1240px, 88%);

    margin: auto;
}

.intro-label {
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.2em;

    color: var(--evo-blue);
}

.intro-content {
    display: grid;
    grid-template-columns: 1.1fr 0.7fr;

    gap: 100px;

    margin-top: 25px;
}

.intro-content h2 {
    margin: 0;

    font-size: clamp(38px, 4.5vw, 65px);
    line-height: 1.08;

    letter-spacing: -0.045em;

    color: var(--evo-dark);
}

.intro-content h2 span {
    color: var(--evo-blue);
}

.intro-content p {
    align-self: end;

    margin: 0;

    font-size: 16px;
    line-height: 1.8;

    color: var(--evo-muted);
}

.intro-values {
    display: grid;
    grid-template-columns: repeat(4, 1fr);

    gap: 0;

    margin-top: 80px;

    border-top: 2px solid #B9C3D0;
}

.intro-value {
    padding: 25px 25px 0;

    border-right: 2px solid #C4CCD8;
}

.intro-value:first-child {
    padding-left: 0;
}

.intro-value:last-child {
    border-right: 0;
}

.intro-value span {
    font-size: 11px;
    font-weight: 800;

    color: var(--evo-blue);
}

.intro-value strong {
    display: block;

    margin-top: 25px;

    font-size: 18px;

    color: var(--evo-dark);
}

.intro-value p {
    margin: 10px 0 0;

    max-width: 220px;

    font-size: 12px;
    line-height: 1.7;

    color: var(--evo-muted);
}


/* =====================================================
   SERVICES
===================================================== */

.application-services {
    padding: 150px 0;
}

.services-container {
    width: min(1280px, 90%);

    margin: auto;
}

.section-heading-row {
    display: grid;
    grid-template-columns: 1fr 0.55fr;

    align-items: end;

    gap: 80px;
}

.section-heading-row h2 {
    margin: 22px 0 0;

    font-size: clamp(42px, 4.8vw, 68px);
    line-height: 1.05;

    letter-spacing: -0.05em;

    color: var(--evo-dark);
}

.section-heading-row h2 span {
    color: var(--evo-blue);
}

.section-heading-row > p {
    margin: 0;

    font-size: 15px;
    line-height: 1.8;

    color: var(--evo-muted);
}

.services-list {
    margin-top: 85px;
}

.service-row {
    position: relative;

    min-height: 260px;

    display: grid;
    grid-template-columns: 70px 1fr 300px 60px;

    align-items: center;

    gap: 35px;

    padding: 32px 0;

    border-top: 2px solid #C5CDD9;

    transition:
        padding 0.4s ease,
        background 0.4s ease;
}

.service-row:last-child {
    border-bottom: 2px solid #C5CDD9;
}

.service-row:hover {
    padding-left: 25px;
    padding-right: 25px;

    background:
        linear-gradient(
            90deg,
            rgba(9, 80, 205, 0.035),
            rgba(60, 210, 249, 0.035)
        );
}

.service-number {
    align-self: start;

    padding-top: 5px;

    font-size: 12px;
    font-weight: 800;

    color: #7D8795;
}

.service-information {
    position: relative;
}

.service-icon {
    width: 46px;
    height: 46px;

    display: flex;
    align-items: center;
    justify-content: center;

    margin-bottom: 20px;

    border-radius: 12px;

    background: rgba(9, 80, 205, 0.07);

    border: 2px solid rgba(9, 80, 205, 0.22);

    color: var(--evo-blue);

    transition:
        background 0.3s ease,
        color 0.3s ease,
        transform 0.3s ease;
}

.service-row:hover .service-icon {
    background: var(--evo-blue);
    color: var(--evo-white);

    transform: rotate(-5deg) scale(1.05);
}

.service-information h3 {
    margin: 0;

    font-size: 28px;
    letter-spacing: -0.03em;

    color: var(--evo-dark);
}

.service-information p {
    max-width: 600px;

    margin: 13px 0 0;

    font-size: 13px;
    line-height: 1.75;

    color: var(--evo-muted);
}

.service-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;

    margin-top: 19px;
}

.service-tags span {
    padding: 6px 10px;

    border: 2px solid var(--evo-border);

    border-radius: 100px;

    background: var(--evo-white);

    font-size: 9px;
    font-weight: 700;

    color: var(--evo-muted);
}

.service-image-wrapper {
    height: 190px;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    border-radius: 15px;

    background:
        linear-gradient(
            135deg,
            #F7FAFF,
            #EEF8FC
        );

    border: 2px solid #C2CBD8;

    box-shadow:
        0 15px 35px rgba(25, 50, 90, 0.08);
}

.service-image-wrapper img {
    width: 100%;
    height: 100%;

    object-fit: cover;

    transition:
        transform 0.5s ease;
}

.service-arrow {
    width: 50px;
    height: 50px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 2px solid var(--evo-blue);

    border-radius: 50%;

    background: var(--evo-white);
    color: var(--evo-blue);

    cursor: pointer;

    transition:
        background-color 0.3s ease,
        border-color 0.3s ease,
        color 0.3s ease,
        transform 0.3s ease;
}

.service-row:hover .service-arrow {
    background: var(--evo-blue);
    border-color: var(--evo-blue);
    color: var(--evo-white);

    transform: rotate(45deg);
}


/* =====================================================
   ECOSYSTEM
===================================================== */

.ecosystem-section {
    padding: 150px 0;

    background: #F8FAFD;

    border-top: 2px solid var(--evo-border);
    border-bottom: 2px solid var(--evo-border);
}

.ecosystem-container {
    width: min(1240px, 88%);

    margin: auto;

    display: grid;
    grid-template-columns: 0.8fr 1.2fr;

    align-items: center;

    gap: 80px;
}

.ecosystem-copy h2 {
    margin: 22px 0;

    font-size: clamp(42px, 4.5vw, 64px);
    line-height: 1.06;

    letter-spacing: -0.05em;

    color: var(--evo-dark);
}

.ecosystem-copy h2 span {
    color: var(--evo-blue);
}

.ecosystem-copy > p {
    max-width: 500px;

    font-size: 15px;
    line-height: 1.8;

    color: var(--evo-muted);
}

.ecosystem-checks {
    display: grid;
    grid-template-columns: 1fr 1fr;

    gap: 14px;

    margin-top: 35px;
}

.ecosystem-checks div {
    display: flex;
    align-items: center;
    gap: 9px;

    font-size: 11px;
    font-weight: 700;

    color: var(--evo-text);
}

.ecosystem-checks svg {
    padding: 3px;

    border-radius: 50%;

    background: rgba(9, 80, 205, 0.08);

    border: 1px solid rgba(9, 80, 205, 0.22);

    color: var(--evo-blue);
}


/* =====================================================
   ECOSYSTEM VISUAL
===================================================== */

.ecosystem-visual {
    position: relative;

    width: 600px;
    height: 600px;

    margin: auto;
}

.ecosystem-ring {
    position: absolute;

    left: 50%;
    top: 50%;

    border: 2px solid rgba(9, 80, 205, 0.20);

    border-radius: 50%;

    transform: translate(-50%, -50%);
}

.ring-one {
    width: 220px;
    height: 220px;
}

.ring-two {
    width: 390px;
    height: 390px;
}

.ring-three {
    width: 540px;
    height: 540px;

    border-color: rgba(60, 210, 249, 0.28);
}

.ecosystem-center {
    position: absolute;

    left: 50%;
    top: 50%;

    width: 145px;
    height: 145px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    gap: 10px;

    transform: translate(-50%, -50%);

    border-radius: 50%;

    background: var(--evo-white);

    border: 2px solid rgba(9, 80, 205, 0.24);

    box-shadow:
        0 25px 60px rgba(9, 80, 205, 0.12);

    color: var(--evo-blue);

    text-align: center;
}

.ecosystem-center strong {
    font-size: 11px;
    line-height: 1.35;
    letter-spacing: 0.08em;

    color: var(--evo-dark);
}

.ecosystem-node {
    position: absolute;

    width: 100px;
    height: 100px;

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    gap: 8px;

    border: 2px solid #BEC7D4;

    border-radius: 20px;

    background: rgba(255, 255, 255, 0.97);

    box-shadow:
        0 18px 40px rgba(30, 50, 80, 0.08);

    color: var(--evo-blue);
}

.ecosystem-node span {
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.1em;

    color: var(--evo-dark);
}

.node-web {
    left: 50%;
    top: 2%;

    transform: translateX(-50%);
}

.node-mobile {
    right: 3%;
    top: 50%;

    transform: translateY(-50%);
}

.node-api {
    left: 50%;
    bottom: 2%;

    transform: translateX(-50%);
}

.node-cloud {
    left: 3%;
    top: 50%;

    transform: translateY(-50%);
}


/* =====================================================
   CLIENT FIRST
===================================================== */

.client-first-section {
    padding: 160px 0;
}

.client-first-container {
    width: min(1240px, 88%);

    margin: auto;

    display: grid;
    grid-template-columns: 1fr 0.85fr;

    align-items: center;

    gap: 100px;
}

.client-first-visual {
    position: relative;

    height: 560px;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    border-radius: 30px;

    background:
        radial-gradient(
            circle at center,
            rgba(60, 210, 249, 0.1),
            transparent 38%
        ),
        #F7FAFD;

    border: 2px solid #C6CEDA;
}

.focus-grid {
    position: absolute;

    inset: 0;

    background:
        linear-gradient(
            rgba(10, 20, 40, 0.10) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(10, 20, 40, 0.10) 1px,
            transparent 1px
        );

    background-size: 32px 32px;

    mask-image: radial-gradient(
        circle,
        black,
        transparent 75%
    );

    -webkit-mask-image: radial-gradient(
        circle,
        black,
        transparent 75%
    );
}

.focus-core {
    position: relative;

    width: 250px;
    height: 250px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 2px dashed rgba(9, 80, 205, 0.35);

    border-radius: 50%;
}

.focus-core-inner {
    width: 110px;
    height: 110px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background:
        linear-gradient(
            135deg,
            var(--evo-blue),
            #1475E8
        );

    color: var(--evo-white);

    box-shadow:
        0 25px 55px rgba(9, 80, 205, 0.25);
}

.focus-card {
    position: absolute;

    width: 175px;

    padding: 15px;

    border: 2px solid #C1CBD8;

    border-radius: 14px;

    background: rgba(255, 255, 255, 0.95);

    backdrop-filter: blur(10px);

    box-shadow:
        0 18px 40px rgba(20, 40, 70, 0.09);

    display: grid;
    grid-template-columns: 34px 1fr;

    column-gap: 10px;
}

.focus-card-icon {
    grid-row: span 2;

    width: 34px;
    height: 34px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 9px;

    background: rgba(9, 80, 205, 0.07);

    border: 1px solid rgba(9, 80, 205, 0.2);

    color: var(--evo-blue);
}

.focus-card strong {
    align-self: end;

    font-size: 11px;

    color: var(--evo-dark);
}

.focus-card span {
    align-self: start;

    margin-top: 3px;

    font-size: 9px;

    color: var(--evo-muted);
}

.focus-user-card {
    top: 12%;
    left: 8%;
}

.focus-business-card {
    right: 7%;
    top: 23%;
}

.focus-tech-card {
    left: 16%;
    bottom: 12%;
}


/* =====================================================
   CLIENT FIRST COPY
===================================================== */

.client-first-copy h2 {
    margin: 22px 0;

    font-size: clamp(42px, 4.2vw, 62px);
    line-height: 1.08;

    letter-spacing: -0.05em;

    color: var(--evo-dark);
}

.client-first-copy h2 span {
    color: var(--evo-blue);
}

.client-first-copy > p {
    max-width: 530px;

    margin: 0 0 16px;

    font-size: 15px;
    line-height: 1.8;

    color: var(--evo-muted);
}

.client-points {
    margin-top: 35px;
}

.client-points > div {
    display: flex;
    align-items: center;
    gap: 13px;

    padding: 13px 0;

    border-bottom: 2px solid #D0D7E1;
}

.client-points > div:first-child {
    border-top: 2px solid #D0D7E1;
}

.client-points span {
    width: 26px;
    height: 26px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 50%;

    background: rgba(60, 210, 249, 0.13);

    border: 1px solid rgba(9, 80, 205, 0.18);

    color: var(--evo-blue);
}

.client-points p {
    margin: 0;

    font-size: 12px;
    font-weight: 600;

    color: var(--evo-text);
}


/* =====================================================
   CAPABILITIES
===================================================== */

.capabilities-section {
    padding: 150px 0;

    background: #F8FAFD;

    border-top: 2px solid var(--evo-border);
}

.capabilities-container {
    width: min(1240px, 88%);

    margin: auto;
}

.capabilities-heading {
    max-width: 750px;
}

.capabilities-heading h2 {
    margin: 22px 0;

    font-size: clamp(42px, 4.5vw, 65px);
    line-height: 1.05;

    letter-spacing: -0.05em;

    color: var(--evo-dark);
}

.capabilities-heading h2 span {
    color: var(--evo-blue);
}

.capabilities-heading p {
    max-width: 600px;

    margin: 0;

    font-size: 15px;
    line-height: 1.8;

    color: var(--evo-muted);
}

.capabilities-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);

    gap: 16px;

    margin-top: 65px;
}

.capability-card {
    min-height: 235px;

    padding: 27px;

    border: 2px solid #C6CEDA;

    border-radius: 18px;

    background: var(--evo-white);

    box-shadow:
        0 8px 30px rgba(20, 40, 70, 0.045);

    transition:
        border-color 0.3s ease,
        box-shadow 0.3s ease,
        transform 0.3s ease;
}

.capability-card:hover {
    border-color: rgba(9, 80, 205, 0.45);

    box-shadow:
        0 25px 50px rgba(20, 40, 70, 0.10);

    transform: translateY(-4px);
}

.capability-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.capability-icon {
    width: 48px;
    height: 48px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 13px;

    background:
        linear-gradient(
            135deg,
            rgba(9, 80, 205, 0.08),
            rgba(60, 210, 249, 0.1)
        );

    border: 2px solid rgba(9, 80, 205, 0.18);

    color: var(--evo-blue);
}

.capability-arrow {
    color: #8C97A6;

    transition:
        color 0.3s ease,
        transform 0.3s ease;
}

.capability-card:hover .capability-arrow {
    color: var(--evo-blue);

    transform: translate(3px, -3px);
}

.capability-card h3 {
    margin: 30px 0 10px;

    font-size: 18px;

    color: var(--evo-dark);
}

.capability-card p {
    max-width: 280px;

    margin: 0;

    font-size: 12px;
    line-height: 1.75;

    color: var(--evo-muted);
}


/* =====================================================
   PROCESS
===================================================== */

.process-section {
    padding: 160px 0;
}

.process-container {
    width: min(1240px, 88%);

    margin: auto;
}

.process-heading {
    text-align: center;
}

.process-heading h2 {
    margin: 22px 0;

    font-size: clamp(42px, 4.5vw, 65px);
    line-height: 1.05;

    letter-spacing: -0.05em;

    color: var(--evo-dark);
}

.process-heading h2 span {
    color: var(--evo-blue);
}

.process-heading p {
    max-width: 570px;

    margin: auto;

    font-size: 15px;
    line-height: 1.8;

    color: var(--evo-muted);
}

.process-track {
    position: relative;

    display: grid;
    grid-template-columns: repeat(6, 1fr);

    gap: 20px;

    margin-top: 90px;
}

.process-progress-line {
    position: absolute;

    top: 28px;
    left: 7%;
    right: 7%;

    height: 2px;

    background:
        linear-gradient(
            90deg,
            var(--evo-blue),
            var(--evo-cyan),
            var(--evo-border-dark)
        );

    z-index: 0;
}

.process-card {
    position: relative;
    z-index: 1;

    padding: 0 8px;
}

.process-number {
    width: 58px;
    height: 58px;

    display: flex;
    align-items: center;
    justify-content: center;

    margin: auto;

    border: 2px solid #BFC8D5;

    border-radius: 50%;

    background: var(--evo-white);

    color: var(--evo-blue);

    font-size: 11px;
    font-weight: 800;

    box-shadow:
        0 8px 20px rgba(20, 40, 70, 0.07);
}

.process-icon {
    width: 44px;
    height: 44px;

    display: flex;
    align-items: center;
    justify-content: center;

    margin: 25px auto 0;

    border-radius: 12px;

    background: rgba(9, 80, 205, 0.07);

    border: 2px solid rgba(9, 80, 205, 0.18);

    color: var(--evo-blue);
}

.process-card h3 {
    margin: 17px 0 9px;

    text-align: center;

    font-size: 16px;

    color: var(--evo-dark);
}

.process-card p {
    margin: 0;

    text-align: center;

    font-size: 10px;
    line-height: 1.7;

    color: var(--evo-muted);
}


/* =====================================================
   CTA
===================================================== */

.web-mobile-cta {
    position: relative;

    min-height: 620px;

    display: flex;
    align-items: center;
    justify-content: center;

    overflow: hidden;

    background:
        radial-gradient(
            circle at 50% 45%,
            rgba(60, 210, 249, 0.13),
            transparent 28%
        ),
        #F7FAFD;

    border-top: 2px solid var(--evo-border);
}

.cta-background-grid {
    position: absolute;

    inset: 0;

    background:
        linear-gradient(
            rgba(10, 20, 40, 0.09) 1px,
            transparent 1px
        ),
        linear-gradient(
            90deg,
            rgba(10, 20, 40, 0.09) 1px,
            transparent 1px
        );

    background-size: 40px 40px;

    mask-image: radial-gradient(
        circle,
        black,
        transparent 70%
    );

    -webkit-mask-image: radial-gradient(
        circle,
        black,
        transparent 70%
    );
}

.cta-glow {
    position: absolute;

    width: 450px;
    height: 450px;

    border-radius: 50%;

    background: rgba(60, 210, 249, 0.09);

    filter: blur(80px);
}

.cta-content {
    position: relative;
    z-index: 5;

    width: min(800px, 90%);

    text-align: center;
}

.cta-content h2 {
    margin: 25px 0;

    font-size: clamp(48px, 6vw, 82px);
    line-height: 1;

    letter-spacing: -0.06em;

    color: var(--evo-dark);
}

.cta-content h2 span {
    color: var(--evo-blue);
}

.cta-content > p {
    max-width: 650px;

    margin: auto;

    font-size: 15px;
    line-height: 1.8;

    color: var(--evo-muted);
}

.cta-buttons {
    display: flex;
    align-items: center;
    justify-content: center;

    gap: 28px;

    margin-top: 38px;
}


/* =====================================================
   CTA FLOATING OBJECTS
===================================================== */

.cta-floating-object {
    position: absolute;

    width: 60px;
    height: 60px;

    display: flex;
    align-items: center;
    justify-content: center;

    border: 2px solid #BEC8D5;

    border-radius: 16px;

    background: rgba(255, 255, 255, 0.90);

    color: var(--evo-blue);

    box-shadow:
        0 20px 40px rgba(20, 40, 70, 0.08);

    animation:
        floatingObject 5s ease-in-out infinite;

    transition:
        background-color 0.3s ease,
        border-color 0.3s ease,
        color 0.3s ease,
        transform 0.3s ease,
        box-shadow 0.3s ease;
}

.cta-floating-object:hover {
    background: var(--evo-blue);
    border-color: var(--evo-blue);
    color: var(--evo-white);

    box-shadow:
        0 20px 40px rgba(9, 80, 205, 0.20);
}

.object-one {
    left: 14%;
    top: 25%;
}

.object-two {
    right: 16%;
    top: 20%;

    animation-delay: -1.7s;
}

.object-three {
    right: 12%;
    bottom: 20%;

    animation-delay: -3s;
}

@keyframes floatingObject {

    0%,
    100% {
        transform: translateY(0) rotate(0deg);
    }

    50% {
        transform: translateY(-12px) rotate(4deg);
    }

}

.cta-footer-line {
    position: absolute;

    left: 50%;
    bottom: 30px;

    transform: translateX(-50%);

    width: max-content;

    display: flex;
    gap: 12px;

    font-size: 8px;
    font-weight: 800;
    letter-spacing: 0.2em;

    color: #7F8998;
}

.cta-footer-line span {
    color: var(--evo-cyan);
}


/* =====================================================
   TABLET
===================================================== */

@media (max-width: 1100px) {

    .web-mobile-hero-container {
        grid-template-columns: 1fr;
    }

    .web-mobile-hero-content {
        max-width: 850px;

        margin: auto;

        text-align: center;
    }

    .eyebrow {
        justify-content: center;
    }

    .hero-description {
        margin-left: auto;
        margin-right: auto;
    }

    .hero-buttons,
    .hero-proof {
        justify-content: center;
    }

    .hero-visual {
        min-height: 600px;
    }

    .intro-content,
    .ecosystem-container,
    .client-first-container {
        grid-template-columns: 1fr;
    }

    .ecosystem-copy {
        text-align: center;
    }

    .ecosystem-copy > p {
        margin-left: auto;
        margin-right: auto;
    }

    .ecosystem-checks {
        max-width: 600px;

        margin-left: auto;
        margin-right: auto;

        text-align: left;
    }

    .client-first-copy {
        max-width: 700px;

        margin: auto;
    }

    .section-heading-row {
        grid-template-columns: 1fr;

        gap: 30px;
    }

    .service-row {
        grid-template-columns: 55px 1fr 240px 50px;

        gap: 20px;
    }

    .capabilities-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .process-track {
        grid-template-columns: repeat(3, 1fr);

        row-gap: 60px;
    }

    .process-progress-line {
        display: none;
    }
}


/* =====================================================
   MOBILE
===================================================== */

@media (max-width: 760px) {

    .web-mobile-hero {
        min-height: auto;

        padding:
            110px
            0
            80px;
    }

    .web-mobile-hero-container {
        width: 90%;
    }

    .web-mobile-hero-content h1 {
        font-size: clamp(40px, 11vw, 58px);
    }

    .hero-description {
        font-size: 14px;
    }

    .hero-buttons {
        flex-direction: column;

        gap: 20px;
    }

    .hero-buttons .primary-button,
    .hero-buttons .secondary-button {
        width: 100%;
        max-width: 320px;
    }

    .hero-proof {
        flex-wrap: wrap;

        gap: 15px;

        margin-top: 40px;
    }

    .proof-divider {
        display: none;
    }

    .proof-item {
        min-width: auto;

        padding: 0 10px;
    }

    .hero-visual {
        min-height: 460px;

        margin-top: 30px;
    }

    .hero-main-device {
        width: 88%;

        min-height: 300px;
    }

    .device-interface {
        min-height: 250px;
    }

    .interface-sidebar {
        width: 45px;
    }

    .interface-main {
        padding: 15px;
    }

    .interface-stat-grid {
        gap: 5px;
    }

    .interface-stat-grid > div {
        padding: 8px;
    }

    .interface-stat-grid strong {
        font-size: 11px;
    }

    .interface-chart {
        height: 115px;
    }

    .floating-web-card {
        top: 7%;
        left: 0;
    }

    .floating-mobile-card {
        right: 0;
        bottom: 16%;
    }

    .floating-api-card {
        left: 4%;
        bottom: 3%;
    }

    .hero-orbit-one {
        width: 350px;
        height: 350px;
    }

    .hero-orbit-two {
        width: 270px;
        height: 270px;
    }

    .hero-visual-grid {
        width: 350px;
        height: 350px;
    }

    .application-intro,
    .application-services,
    .ecosystem-section,
    .client-first-section,
    .capabilities-section,
    .process-section {
        padding: 90px 0;
    }

    .intro-content {
        gap: 25px;
    }

    .intro-content h2,
    .ecosystem-copy h2,
    .client-first-copy h2,
    .capabilities-heading h2,
    .process-heading h2 {
        font-size: 42px;
    }

    .intro-values {
        grid-template-columns: 1fr 1fr;

        margin-top: 50px;
    }

    .intro-value {
        min-height: 150px;

        padding: 20px 15px;

        border-bottom: 2px solid #C4CCD8;
    }

    .intro-value:nth-child(2) {
        border-right: 0;
    }

    .intro-value:first-child {
        padding-left: 0;
    }

    .intro-value strong {
        margin-top: 15px;
    }

    .services-list {
        margin-top: 50px;
    }

    .service-row {
        grid-template-columns: 40px 1fr;

        gap: 12px;

        padding: 30px 0;
    }

    .service-row:hover {
        padding-left: 10px;
        padding-right: 10px;
    }

    .service-image-wrapper {
        grid-column: 2;

        width: 100%;
        height: 180px;
    }

    .service-arrow {
        position: absolute;

        right: 10px;
        top: 30px;

        width: 40px;
        height: 40px;
    }

    .service-information h3 {
        padding-right: 45px;

        font-size: 23px;
    }

    .ecosystem-visual {
        width: 100%;
        height: 460px;
    }

    .ring-one {
        width: 170px;
        height: 170px;
    }

    .ring-two {
        width: 290px;
        height: 290px;
    }

    .ring-three {
        width: 400px;
        height: 400px;
    }

    .ecosystem-node {
        width: 78px;
        height: 78px;

        border-radius: 15px;
    }

    .ecosystem-node span {
        font-size: 7px;
    }

    .ecosystem-center {
        width: 115px;
        height: 115px;
    }

    .ecosystem-checks {
        grid-template-columns: 1fr;
    }

    .client-first-visual {
        height: 440px;
    }

    .focus-core {
        width: 190px;
        height: 190px;
    }

    .focus-core-inner {
        width: 90px;
        height: 90px;
    }

    .focus-card {
        width: 145px;
    }

    .focus-user-card {
        top: 8%;
        left: 2%;
    }

    .focus-business-card {
        right: 2%;
        top: 18%;
    }

    .focus-tech-card {
        left: 8%;
        bottom: 8%;
    }

    .capabilities-grid {
        grid-template-columns: 1fr;
    }

    .capability-card {
        min-height: 210px;
    }

    .process-track {
        grid-template-columns: 1fr;

        gap: 35px;

        margin-top: 55px;
    }

    .process-card {
        display: grid;
        grid-template-columns: 55px 1fr;

        column-gap: 18px;

        text-align: left;
    }

    .process-number {
        grid-row: span 3;

        margin: 0;
    }

    .process-icon {
        margin: 0;
    }

    .process-card h3 {
        margin: 10px 0 5px;

        text-align: left;
    }

    .process-card p {
        text-align: left;
    }

    .web-mobile-cta {
        min-height: 560px;
    }

    .cta-content h2 {
        font-size: 48px;
    }

    .cta-buttons {
        flex-direction: column;

        gap: 22px;
    }

    .cta-buttons .primary-button,
    .cta-buttons .secondary-button,
    .cta-buttons .cta-talk-button {
        width: 100%;
        max-width: 320px;
    }

    .cta-floating-object {
        width: 47px;
        height: 47px;
    }

    .object-one {
        left: 5%;
        top: 15%;
    }

    .object-two {
        right: 5%;
        top: 15%;
    }

    .object-three {
        right: 7%;
        bottom: 15%;
    }

    .cta-footer-line {
        font-size: 6px;

        gap: 7px;
    }
}


/* =====================================================
   SMALL MOBILE
===================================================== */

@media (max-width: 480px) {

    .web-mobile-hero-content h1 {
        font-size: 39px;
    }

    .hero-description {
        font-size: 13px;
        line-height: 1.7;
    }

    .hero-main-device {
        width: 95%;
    }

    .browser-address {
        display: none;
    }

    .interface-sidebar {
        width: 38px;
    }

    .interface-sidebar > span,
    .interface-logo {
        width: 27px;
        height: 27px;
    }

    .interface-main {
        padding: 10px;
    }

    .interface-stat-grid {
        grid-template-columns: 1fr;
    }

    .interface-stat-grid > div:nth-child(3) {
        display: none;
    }

    .interface-chart {
        display: none;
    }

    .floating-web-card,
    .floating-mobile-card,
    .floating-api-card {
        padding: 9px 10px;
    }

    .hero-floating-card strong {
        font-size: 7px;
    }

    .hero-floating-card span {
        font-size: 7px;
    }

    .intro-values {
        grid-template-columns: 1fr;
    }

    .intro-value,
    .intro-value:nth-child(2) {
        border-right: 0;
    }

    .intro-value:last-child {
        border-bottom: 0;
    }

    .service-number {
        font-size: 10px;
    }

    .service-information p {
        font-size: 12px;
    }

    .service-image-wrapper {
        height: 150px;
    }

    .ecosystem-visual {
        height: 390px;
    }

    .ring-three {
        width: 330px;
        height: 330px;
    }

    .focus-card {
        width: 130px;
    }

    .client-first-visual {
        height: 400px;
    }

    .cta-content h2 {
        font-size: 42px;
    }

    .primary-button,
    .secondary-button,
    .cta-talk-button {
        min-height: 50px;
        padding: 0 20px;
    }
}